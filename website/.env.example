# Defaults work with: docker compose up --build -d
# Host Nginx serves arcade.afroawi.com and proxies to this loopback-only port.
PORT=28481
HOST_BIND=127.0.0.1
PUBLIC_URL=https://arcade.afroawi.com
TRUST_PROXY=1
BENCHMARK_DIR=./benchmark-data
REPOSITORY_URL=https://github.com/surafel-kindu/system-one-models-game-test
SUBMISSIONS_PER_HOUR=5

# Optional Caddy overlay for hosts WITHOUT an existing Nginx/reverse proxy.
# Host Nginx deployments use compose.yaml alone.
PUBLIC_DOMAIN=arcade.afroawi.com

# For direct local HTTP testing, override these two values instead:
# PUBLIC_URL=http://localhost:28481
# TRUST_PROXY=0
