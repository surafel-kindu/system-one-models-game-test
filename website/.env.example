# Defaults work with: docker compose up --build -d
PORT=8080
HOST_BIND=127.0.0.1
BENCHMARK_DIR=./benchmark-data
REPOSITORY_URL=https://github.com/surafel-kindu/system-one-models-game-test
SUBMISSIONS_PER_HOUR=5

# Optional HTTPS: point this domain to your host, then use compose.https.yaml.
PUBLIC_DOMAIN=benchmarks.example.com
# With your own reverse proxy, set the external URL and trust exactly one proxy.
PUBLIC_URL=
TRUST_PROXY=0
