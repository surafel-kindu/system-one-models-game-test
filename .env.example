# Copy to .env and fill in. .env is git-ignored.

# Jev-BERTa needs no key — it's local. Optional tuning:
# JEV_BATCH_SIZE=4 (default)
# Rows encoded per forward pass within one predict() call. Matters most for Chess, which
# can offer up to 14 choices at once.

DREX_API_KEY=
# DREX_MODEL=drex-latest
# DREX_CONCURRENCY=2   # free tier allows 2 concurrent requests, paid 16

# Kev needs no key by default — it's a server you run yourself (see kev-repo/README.md).
# Only set these if you changed its port/host or started it with KEV_API_KEY.
# KEV_URL=http://127.0.0.1:8009/v1/systemone
# KEV_API_KEY=
# KEV_MODEL=kev-latest
# KEV_CONCURRENCY=1
